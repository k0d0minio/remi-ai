# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.

APP_URL=http://localhost:3000

# Where each app answers, per Vercel project. Overrides for the catalogue in
# packages/services/src/shared/links.ts; unset in production, the catalogue's
# placeholder domain answers instead. The product links out to all three.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_DOCS_URL=http://localhost:3003
NEXT_PUBLIC_SUPPORT_URL=http://localhost:3004

# Storage / auth / email / AI — no vendor is committed yet. Fill these in when
# packages/services gains its first adapter; see packages/services/AGENTS.md.
# DATABASE_URL=
# AUTH_SECRET=
# EMAIL_FROM=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=


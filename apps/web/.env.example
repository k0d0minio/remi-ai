# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.
# A target names where Vercel sets the value: production, preview or uat. The uat environment is the client's test address. The note says what value each target takes.

# Absolute base URL of this app. Production: https://app.remi-ai.tech. uat: https://uat-app.remi-ai.tech. Preview: unset today. Local: http://localhost:3000. [production,preview,uat]
APP_URL=

# Where apps/marketing answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Production and uat: https://remi-ai.tech (marketing has no uat). Preview: unset today. Local: http://localhost:3001. [production,preview,uat]
NEXT_PUBLIC_MARKETING_URL=

# Where apps/docs answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Production and uat: https://docs.remi-ai.tech (docs has no uat). Preview: unset today. Local: http://localhost:3003. [production,preview,uat]
NEXT_PUBLIC_DOCS_URL=

# Signs the admin session cookie. One value per target, made with `openssl rand -base64 32`: uat never reuses production's. Rotating it signs every operator out. [production,preview,uat]
AUTH_SECRET=

# The one email allowed to create the first operator account; stops working once that account exists. uat may take its own test address. [production,preview,uat]
OPERATOR_EMAIL=

# Neon connection string — the whole storage configuration (pooled, WebSocket driver). Set by the Neon integration, never by hand: production from the store remi-ai, uat from the store uat-remi-ai (its main branch), preview from the branch preview/<git branch> of uat-remi-ai. [production,preview,uat]
DATABASE_URL=

# Direct (unpooled) connection string of the same database. Set by the Neon integration with DATABASE_URL. The app does not read it. vercel-build.sh gives it to db:migrate and db:verify. [production,preview,uat]
DATABASE_URL_UNPOOLED=

# Set by the Neon integration when the store exposes Neon Auth. Today only the store remi-ai (production) exposes it. The ticket patient-signup-account/auth-seam names what preview and uat need. The code does not read it yet. [production]
NEON_AUTH_BASE_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
NEON_PROJECT_ID=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGDATABASE=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST_UNPOOLED=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGPASSWORD=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGUSER=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_DATABASE=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_HOST=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PASSWORD=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PRISMA_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NON_POOLING=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NO_SSL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_USER=

# Set by the Neon integration when the store exposes Neon Auth. Today only the store remi-ai (production) exposes it. The ticket patient-signup-account/auth-seam names what preview and uat need. The code does not read it yet. [production]
VITE_NEON_AUTH_URL=

# Direct Anthropic API access. AI has no vendor adapter yet: set nothing until one reads it. [production,preview]
ANTHROPIC_API_KEY=

# Vercel AI Gateway key, if AI routes through the gateway. AI has no vendor adapter yet: set nothing until one reads it. [production,preview]
AI_GATEWAY_API_KEY=

# Read-write token of the private, EU-region Vercel Blob store behind the files seam. Production: the token of the store document-storage. Preview and uat: the token of the store uat-document-storage, added by hand (the store connection exposes only BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY). Unset: no file store is registered, uploads are refused and files cannot be opened. [production,preview,uat]
BLOB_READ_WRITE_TOKEN=

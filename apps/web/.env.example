# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.

# Absolute base URL of this app. Local: http://localhost:3000. [production,preview]
APP_URL=

# Where apps/marketing answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3001. [production,preview]
NEXT_PUBLIC_MARKETING_URL=

# Where apps/docs answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3003. [production,preview]
NEXT_PUBLIC_DOCS_URL=

# Where apps/support answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3004. [production,preview]
NEXT_PUBLIC_SUPPORT_URL=

# Where apps/demo answers — overrides the catalogue in packages/services/src/shared/links.ts. No app links to the demo yet. Local: http://localhost:3005. [production,preview]
NEXT_PUBLIC_DEMO_URL=

# Signs the admin session cookie. Rotating it signs every operator out. [production,preview]
AUTH_SECRET=

# The one email allowed to create the first operator account; stops working once that account exists. [production,preview]
OPERATOR_EMAIL=

# Neon connection string — the whole storage configuration (pooled, WebSocket driver). [production,preview]
DATABASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
DATABASE_URL_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
NEON_AUTH_BASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
NEON_PROJECT_ID=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGDATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGHOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGHOST_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGPASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGUSER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_DATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_HOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_PASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_PRISMA_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL_NON_POOLING=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL_NO_SSL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_USER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
VITE_NEON_AUTH_URL=

# Direct Anthropic API access. AI has no vendor adapter yet. [production,preview]
ANTHROPIC_API_KEY=

# Vercel AI Gateway key, if AI routes through the gateway. AI has no vendor adapter yet. [production,preview]
AI_GATEWAY_API_KEY=

# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.
# A target names where Vercel sets the value: production, preview or uat. The uat environment is the client's test address.

# Absolute base URL of this app. Local: http://localhost:3000. [production,preview,uat]
APP_URL=

# Where apps/marketing answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3001. [production,preview,uat]
NEXT_PUBLIC_MARKETING_URL=

# Where apps/docs answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3003. [production,preview,uat]
NEXT_PUBLIC_DOCS_URL=

# Signs the admin session cookie. Rotating it signs every operator out. [production,preview,uat]
AUTH_SECRET=

# The one email allowed to create the first operator account; stops working once that account exists. [production,preview,uat]
OPERATOR_EMAIL=

# Neon connection string — the whole storage configuration (pooled, WebSocket driver). [production,preview,uat]
DATABASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
DATABASE_URL_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
NEON_AUTH_BASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
NEON_PROJECT_ID=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGDATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGPASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGUSER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_DATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_HOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PRISMA_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NON_POOLING=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NO_SSL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_USER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
VITE_NEON_AUTH_URL=

# Direct Anthropic API access. AI has no vendor adapter yet. [production,preview]
ANTHROPIC_API_KEY=

# Vercel AI Gateway key, if AI routes through the gateway. AI has no vendor adapter yet. [production,preview]
AI_GATEWAY_API_KEY=

# Read-write token of the private, EU-region Vercel Blob store behind the files seam. Unset: no file store is registered, uploads are refused and files cannot be opened. [production,preview,uat]
BLOB_READ_WRITE_TOKEN=

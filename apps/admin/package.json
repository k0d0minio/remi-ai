{
  "name": "@remi/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "pnpm --filter @remi/services db:migrate && next build",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "env:pull": "vercel env pull .env.local"
  },
  "engines": { "node": "22.x" },
  "dependencies": {
    "@remi/services": "workspace:*",
    "@remi/ui": "workspace:*",
    "@vercel/analytics": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}

# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.

# Absolute base URL of this app. Local: http://localhost:3002. [production,preview]
APP_URL=

# Where apps/admin answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3002. [production,preview]
NEXT_PUBLIC_ADMIN_URL=

# Where apps/web answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3000. [production,preview]
NEXT_PUBLIC_APP_URL=

# Signs the admin session cookie. Rotating it signs every operator out. [production,preview]
AUTH_SECRET=

# The one email allowed to create the first operator account; stops working once that account exists. [production,preview]
OPERATOR_EMAIL=

# Neon connection string — the whole storage configuration (pooled, WebSocket driver). [production,preview]
DATABASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
DATABASE_URL_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
NEON_AUTH_BASE_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
NEON_PROJECT_ID=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGDATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGHOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGHOST_UNPOOLED=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGPASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
PGUSER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_DATABASE=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_HOST=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_PASSWORD=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_PRISMA_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL_NON_POOLING=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_URL_NO_SSL=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
POSTGRES_USER=

# Set by the Neon–Vercel integration; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview]
VITE_NEON_AUTH_URL=

# `true` lets a preview build migrate the database it is given. Unset by default — an escape hatch only; reach for a Neon branch first. [preview]
ALLOW_NON_PRODUCTION_MIGRATIONS=

# Default from-address for outbound email; must be on a domain verified in Resend. [production,preview]
EMAIL_FROM=

# Resend API key, read on every send. Unset: the console mailer logs and sends nothing. [production,preview]
RESEND_API_KEY=

# Read-write token of the private, EU-region Vercel Blob store behind the files seam. Unset: no file store is registered, uploads are refused and files cannot be opened. [production,preview]
BLOB_READ_WRITE_TOKEN=

# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.
# A target names where Vercel sets the value: production, preview or uat. The uat environment is the client's test address. The note says what value each target takes.

# Absolute base URL of this app. Production: https://admin.remi-ai.tech. uat: https://uat-admin.remi-ai.tech. Preview: unset today. Local: http://localhost:3002. [production,preview,uat]
APP_URL=

# Where apps/admin answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Production: https://admin.remi-ai.tech. uat: https://uat-admin.remi-ai.tech. Preview: unset today. Local: http://localhost:3002. [production,preview,uat]
NEXT_PUBLIC_ADMIN_URL=

# Where apps/web answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Production: https://app.remi-ai.tech. uat: https://uat-app.remi-ai.tech. Preview: unset today. Local: http://localhost:3000. [production,preview,uat]
NEXT_PUBLIC_APP_URL=

# Signs the admin session cookie. One value per target, made with `openssl rand -base64 32`: uat never reuses production's. Rotating it signs every operator out. [production,preview,uat]
AUTH_SECRET=

# The one email allowed to create the first operator account; stops working once that account exists. uat may take its own test address. [production,preview,uat]
OPERATOR_EMAIL=

# Neon connection string — the whole storage configuration (pooled, WebSocket driver). Set by the Neon integration, never by hand: production from the store remi-ai, uat from the store uat-remi-ai (its main branch), preview from the branch preview/<git branch> of uat-remi-ai. [production,preview,uat]
DATABASE_URL=

# Direct (unpooled) connection string of the same database. Set by the Neon integration with DATABASE_URL. The app does not read it. db.sh build gives it to db:migrate and db:verify. [production,preview,uat]
DATABASE_URL_UNPOOLED=

# Set by the Neon integration when the store exposes Neon Auth. Today only the store remi-ai (production) exposes it. The ticket patient-signup-account/auth-seam names what preview and uat need. The code does not read it yet. [production]
NEON_AUTH_BASE_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
NEON_PROJECT_ID=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGDATABASE=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGHOST_UNPOOLED=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGPASSWORD=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
PGUSER=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_DATABASE=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_HOST=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PASSWORD=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_PRISMA_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NON_POOLING=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_URL_NO_SSL=

# Set by the Neon integration on every target; the code does not read it — DATABASE_URL is the whole storage configuration. [production,preview,uat]
POSTGRES_USER=

# Set by the Neon integration when the store exposes Neon Auth. Today only the store remi-ai (production) exposes it. The ticket patient-signup-account/auth-seam names what preview and uat need. The code does not read it yet. [production]
VITE_NEON_AUTH_URL=

# Default from-address for outbound email; must be on a domain verified in Resend. Today on every target: REMI <no-reply@mail.jamienisbet.com>, until remiai.be is verified in Resend. Preview may leave it unset with RESEND_API_KEY. [production,preview,uat]
EMAIL_FROM=

# Resend API key, read on every send. Production: the live key. uat and preview: a key of a separate Resend account or sandbox, never the live key. Unset: the console mailer logs and sends nothing. [production,preview,uat]
RESEND_API_KEY=

# Read-write token of the private, EU-region Vercel Blob store behind the files seam. Production: the token of the store document-storage. Preview and uat: the token of the store uat-document-storage, added by hand (the store connection exposes only BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY). Unset: no file store is registered, uploads are refused and files cannot be opened. [production,preview,uat]
BLOB_READ_WRITE_TOKEN=
# Vercel AI Gateway key. Unset: no AI adapter registers and each generation fails [production, preview, uat, development]
AI_GATEWAY_API_KEY=


{
  "name": "@remi/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind || echo 'pagefind: nothing prerendered to index — the site renders dynamically behind the operator gate'",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "env:pull": "vercel env pull .env.local"
  },
  "engines": { "node": "22.x" },
  "dependencies": {
    "@remi/services": "workspace:*",
    "@vercel/analytics": "catalog:",
    "next": "catalog:",
    "nextra": "^4.6.0",
    "nextra-theme-docs": "^4.6.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.39.1",
    "pagefind": "^1.4.0",
    "typescript": "catalog:"
  }
}

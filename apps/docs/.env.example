# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in .icm/docs/ENV.md.
# One block per key: a note, an optional [targets] suffix, then KEY= with no value.

# Where apps/web answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3000. [production,preview]
NEXT_PUBLIC_APP_URL=

# Where apps/marketing answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3001. [production,preview]
NEXT_PUBLIC_MARKETING_URL=

# Where apps/support answers — overrides the catalogue in packages/services/src/shared/links.ts. Inlined at build: redeploy after changing it. Local: http://localhost:3004. [production,preview]
NEXT_PUBLIC_SUPPORT_URL=

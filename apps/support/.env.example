# Copy to .env.local for local work, or run `pnpm --filter <app> env:pull`.
# Values never enter git. The catalogue of every variable lives in docs/ENV.md.

APP_URL=http://localhost:3004

# The help centre links out to the public site and to the product; both fall back
# to their dev ports when unset, so `pnpm support:dev` works with nothing here.
NEXT_PUBLIC_SUPPORT_URL=http://localhost:3004
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
storybook-static/
*.tsbuildinfo

# caches
.turbo/
.eslintcache

# env — values never enter git; the catalogue of names lives in .icm/docs/ENV.md
.env
.env.*
!.env.example

# platform
.vercel/
.DS_Store

# agent-local state
.claude/settings.local.json

# media — large binaries never enter git
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Client material never lives in this repository (icm-board decision D47, 2026-09-26): its home is
# icm-board workspaces/deals/<client>/<engagement>/raw/. raw/ and processed/ are local working
# folders for process-raw.sh; only the template's README and .gitkeep files are tracked.
.icm/raw/**
!.icm/raw/README.md
!.icm/raw/_processed/
!.icm/raw/_processed/.gitkeep
.icm/processed/**
!.icm/processed/.gitkeep

{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", "eslint.config.ts", "prettier.config.js"],
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "DATABASE_URL",
    "AUTH_SECRET",
    "OPERATOR_EMAIL",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "AI_GATEWAY_API_KEY",
    "ANTHROPIC_API_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_MARKETING_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_SUPPORT_URL",
    "NEXT_PUBLIC_DEMO_URL"
  ],
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false,
      "inputs": [],
      "outputs": []
    },
    "env:pull": {
      "cache": false,
      "persistent": false
    }
  }
}
